# Environment configuration template for Lost & Found Management System
# Copy this file to .env and configure appropriate values for your environment.
# Never commit real credentials or production secret keys to version control.

# ─── Core Security ────────────────────────────────────────────────────────────

# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-lost-and-found-project

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts, e.g. yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ─── HTTPS / Production Security (set all to True in production) ──────────────

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# HSTS duration in seconds: 31536000 = 1 year (enable only after SSL is confirmed working)
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# ─── Email Configuration ──────────────────────────────────────────────────────
# Development: console backend prints emails to stdout
# Production: switch to smtp backend and configure SMTP credentials

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=noreply@lostandfound.local

# ─── Matching Engine ──────────────────────────────────────────────────────────
# Minimum score (0-100) for a Lost/Found pair to be presented as a potential match
MATCH_THRESHOLD=50
